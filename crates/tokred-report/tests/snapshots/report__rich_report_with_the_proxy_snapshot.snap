---
source: crates/tokred-report/tests/report.rs
expression: render_html(&data)
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>tokred metrics</title>
<style>:root {
  color-scheme: light dark;
  --bg: #f6f7f9;
  --card: #ffffff;
  --text: #1b1f24;
  --muted: #57606a;
  --border: #d0d7de;
  --danger: #b42318;
  --c0: #7a3fd1;
  --c1: #0969da;
  --c2: #1a7f37;
  --c3: #6e7781;
  --c4: #bc4c00;
  --c5: #a40e6c;
  --font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --card: #161b22;
    --text: #e6edf3;
    --muted: #9da7b3;
    --border: #30363d;
    --danger: #ff8b7e;
    --c0: #b392f0;
    --c1: #58a6ff;
    --c2: #56d364;
    --c3: #8b949e;
    --c4: #f0883e;
    --c5: #f778ba;
  }
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 15px/1.5 var(--font);
}
header, main, footer { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
header { padding-top: 24px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; justify-content: space-between; }
h1 { margin: 0; font-size: 1.6rem; }
h2 { margin: 0 0 12px; font-size: 1.15rem; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
h3 { margin: 16px 0 6px; font-size: 0.95rem; color: var(--muted); }
.sub { margin: 4px 0 0; color: var(--muted); }
section {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px;
  margin: 16px 0;
}
.cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
.card { border: 1px solid var(--border); border-radius: 8px; padding: 12px; }
.card .k { color: var(--muted); font-size: 0.85rem; }
.card .v { font-size: 1.6rem; font-weight: 650; }
.card .n { color: var(--muted); font-size: 0.8rem; }
.est {
  display: inline-block;
  border: 1px dashed var(--muted);
  border-radius: 999px;
  padding: 0 8px;
  color: var(--muted);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}
.empty {
  margin: 0;
  padding: 16px;
  border: 1px dashed var(--border);
  border-radius: 8px;
  color: var(--muted);
}
.note { color: var(--muted); font-size: 0.85rem; margin: 8px 0 0; }
.warn { color: var(--danger); }
.toolbar { display: flex; gap: 6px; align-items: center; color: var(--muted); font-size: 0.85rem; }
.toolbar button {
  font: inherit;
  color: var(--text);
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 4px 12px;
  cursor: pointer;
}
.toolbar button[aria-pressed="true"] { border-color: var(--c1); box-shadow: inset 0 -2px 0 var(--c1); font-weight: 600; }
button:focus-visible, .chart [tabindex]:focus-visible { outline: 2px solid var(--c1); outline-offset: 2px; }
.pane { display: none; }
body[data-period="7"] .pane[data-pane="7"],
body[data-period="30"] .pane[data-pane="30"],
body[data-period="all"] .pane[data-pane="all"] { display: block; }
.chart { display: block; width: 100%; height: auto; max-width: 720px; }
.chart.donut { max-width: 210px; margin: 0 auto; }
.donuts { display: flex; flex-wrap: wrap; gap: 24px; justify-content: center; }
.donuts figure { margin: 0; flex: 0 1 220px; text-align: center; }
.donuts figcaption { color: var(--muted); font-size: 0.85rem; }
.s0 { --c: var(--c0); }
.s1 { --c: var(--c1); }
.s2 { --c: var(--c2); }
.s3 { --c: var(--c3); }
.s4 { --c: var(--c4); }
.s5 { --c: var(--c5); }
.line { fill: none; stroke: var(--c); stroke-width: 2.5; }
.line.dash { stroke-dasharray: 7 4; }
.dot, .bar { fill: var(--c); }
.dot:hover, .bar:hover { opacity: 0.8; }
.slice { stroke: var(--c); }
.ring { stroke: var(--border); }
.grid { stroke: var(--border); stroke-width: 1; }
.ref { stroke: var(--danger); stroke-width: 1.5; stroke-dasharray: 4 3; }
.tick, .nodata { fill: var(--muted); font-size: 11px; font-family: var(--font); }
.label, .val { fill: var(--text); font-size: 11px; font-family: var(--font); }
.center { fill: var(--text); font-size: 17px; font-weight: 600; font-family: var(--font); }
.legend { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 0; margin: 8px 0 0; font-size: 0.85rem; }
.sw { display: inline-block; width: 22px; height: 4px; margin-right: 6px; vertical-align: middle; background: var(--c); }
td .sw { width: 10px; height: 10px; border-radius: 2px; }
.sw.dash { background: repeating-linear-gradient(90deg, var(--c) 0 6px, transparent 6px 10px); }
.table-wrap { overflow-x: auto; margin-top: 12px; }
table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); }
th { color: var(--muted); font-weight: 600; }
.num { text-align: right; font-variant-numeric: tabular-nums; }
code { font-family: var(--mono); font-size: 0.9em; }
#tip {
  position: fixed;
  z-index: 10;
  max-width: 280px;
  padding: 6px 10px;
  border-radius: 6px;
  background: var(--text);
  color: var(--bg);
  font-size: 0.8rem;
  pointer-events: none;
}
footer { color: var(--muted); font-size: 0.8rem; padding-bottom: 32px; }
footer p { margin: 4px 0; }
@media (max-width: 560px) {
  body { font-size: 14px; }
  section { padding: 12px; }
  .card .v { font-size: 1.35rem; }
}
</style>
</head>
<body data-period="all">
<header><div><h1>tokred metrics</h1><p class="sub">Period: 2026-09-27 to 2026-10-31</p></div><div class="toolbar" id="period-toolbar" role="group" aria-label="Period of the summary and the daily charts" hidden>Summary and daily charts:<button type="button" data-period="7" aria-pressed="false">7 days</button><button type="button" data-period="30" aria-pressed="false">30 days</button><button type="button" data-period="all" aria-pressed="true">All</button></div></header><main><section id="summary" aria-labelledby="summary-heading"><h2 id="summary-heading">Summary</h2><div class="cards"><div class="card"><div class="k">Real cost</div><div class="v">$123.46</div><div class="n">over the period</div></div><div class="card"><div class="k">Total saving <span class="est" title="Estimate: derived from sizes or projections, not measured">estimate</span></div><div class="v">$222.85</div><div class="n">routing $210.50 + guards $12.35</div></div><div class="card"><div class="k">Tokens avoided <span class="est" title="Estimate: derived from sizes or projections, not measured">estimate</span></div><div class="v">1.2M</div><div class="n">1,234,567 tokens, by the guards</div></div><div class="card"><div class="k">Monthly projection <span class="est" title="Estimate: derived from sizes or projections, not measured">estimate</span></div><div class="v">$135.00</div><div class="n">at the recent daily average</div></div><div class="card"><div class="k">Latency added</div><div class="v">4.32 s</div><div class="n">by all hooks, in total</div></div></div></section><section id="cost" aria-labelledby="cost-heading"><h2 id="cost-heading">Cost per day</h2><div class="pane" data-pane="7"><svg class="chart" viewBox="0 0 640.0 240.0" role="img" aria-labelledby="cost-7-title"><title id="cost-7-title">Cost per day: real cost versus everything on opus</title><line class="grid" x1="56.0" y1="210.0" x2="628.0" y2="210.0"/><text class="tick" x="50.0" y="214.0" text-anchor="end">$0.00</text><line class="grid" x1="56.0" y1="160.5" x2="628.0" y2="160.5"/><text class="tick" x="50.0" y="164.5" text-anchor="end">$5.00</text><line class="grid" x1="56.0" y1="111.0" x2="628.0" y2="111.0"/><text class="tick" x="50.0" y="115.0" text-anchor="end">$10.00</text><line class="grid" x1="56.0" y1="61.5" x2="628.0" y2="61.5"/><text class="tick" x="50.0" y="65.5" text-anchor="end">$15.00</text><line class="grid" x1="56.0" y1="12.0" x2="628.0" y2="12.0"/><text class="tick" x="50.0" y="16.0" text-anchor="end">$20.00</text><text class="tick" x="56.0" y="228.0" text-anchor="middle">2026-10-25</text><text class="tick" x="246.7" y="228.0" text-anchor="middle">2026-10-27</text><text class="tick" x="437.3" y="228.0" text-anchor="middle">2026-10-29</text><text class="tick" x="628.0" y="228.0" text-anchor="middle">2026-10-31</text><polyline class="line s4" points="56.0,190.2 151.3,180.3 246.7,170.4 342.0,160.5 437.3,150.6 532.7,140.7 628.0,130.8"/><circle class="dot s4" cx="56.0" cy="190.2" r="3" tabindex="0" data-tip="2026-10-25: Real cost $2.00"/><circle class="dot s4" cx="151.3" cy="180.3" r="3" tabindex="0" data-tip="2026-10-26: Real cost $3.00"/><circle class="dot s4" cx="246.7" cy="170.4" r="3" tabindex="0" data-tip="2026-10-27: Real cost $4.00"/><circle class="dot s4" cx="342.0" cy="160.5" r="3" tabindex="0" data-tip="2026-10-28: Real cost $5.00"/><circle class="dot s4" cx="437.3" cy="150.6" r="3" tabindex="0" data-tip="2026-10-29: Real cost $6.00"/><circle class="dot s4" cx="532.7" cy="140.7" r="3" tabindex="0" data-tip="2026-10-30: Real cost $7.00"/><circle class="dot s4" cx="628.0" cy="130.8" r="3" tabindex="0" data-tip="2026-10-31: Real cost $8.00"/><polyline class="line s3 dash" points="56.0,162.5 151.3,138.7 246.7,115.0 342.0,91.2 437.3,67.4 532.7,43.7 628.0,19.9"/><circle class="dot s3" cx="56.0" cy="162.5" r="3" tabindex="0" data-tip="2026-10-25: Everything on opus $4.80"/><circle class="dot s3" cx="151.3" cy="138.7" r="3" tabindex="0" data-tip="2026-10-26: Everything on opus $7.20"/><circle class="dot s3" cx="246.7" cy="115.0" r="3" tabindex="0" data-tip="2026-10-27: Everything on opus $9.60"/><circle class="dot s3" cx="342.0" cy="91.2" r="3" tabindex="0" data-tip="2026-10-28: Everything on opus $12.00"/><circle class="dot s3" cx="437.3" cy="67.4" r="3" tabindex="0" data-tip="2026-10-29: Everything on opus $14.40"/><circle class="dot s3" cx="532.7" cy="43.7" r="3" tabindex="0" data-tip="2026-10-30: Everything on opus $16.80"/><circle class="dot s3" cx="628.0" cy="19.9" r="3" tabindex="0" data-tip="2026-10-31: Everything on opus $19.20"/></svg><ul class="legend"><li><span class="sw s4" aria-hidden="true"></span>Real cost</li><li><span class="sw s3 dash" aria-hidden="true"></span>Everything on opus</li></ul><p class="note">Shown period: real $35.00 versus $84.00 if everything ran on opus (difference $49.00).</p></div><div class="pane" data-pane="30"><svg class="chart" viewBox="0 0 640.0 240.0" role="img" aria-labelledby="cost-30-title"><title id="cost-30-title">Cost per day: real cost versus everything on opus</title><line class="grid" x1="56.0" y1="210.0" x2="628.0" y2="210.0"/><text class="tick" x="50.0" y="214.0" text-anchor="end">$0.00</text><line class="grid" x1="56.0" y1="160.5" x2="628.0" y2="160.5"/><text class="tick" x="50.0" y="164.5" text-anchor="end">$5.00</text><line class="grid" x1="56.0" y1="111.0" x2="628.0" y2="111.0"/><text class="tick" x="50.0" y="115.0" text-anchor="end">$10.00</text><line class="grid" x1="56.0" y1="61.5" x2="628.0" y2="61.5"/><text class="tick" x="50.0" y="65.5" text-anchor="end">$15.00</text><line class="grid" x1="56.0" y1="12.0" x2="628.0" y2="12.0"/><text class="tick" x="50.0" y="16.0" text-anchor="end">$20.00</text><text class="tick" x="56.0" y="228.0" text-anchor="middle">2026-10-02</text><text class="tick" x="154.6" y="228.0" text-anchor="middle">2026-10-07</text><text class="tick" x="253.2" y="228.0" text-anchor="middle">2026-10-12</text><text class="tick" x="351.9" y="228.0" text-anchor="middle">2
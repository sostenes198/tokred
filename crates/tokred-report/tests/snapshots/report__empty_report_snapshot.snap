---
source: crates/tokred-report/tests/report.rs
expression: "render_html(&ReportData::default())"
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>tokred metrics</title>
<style>:root {
  color-scheme: light dark;
  --bg: #f6f7f9;
  --card: #ffffff;
  --text: #1b1f24;
  --muted: #57606a;
  --border: #d0d7de;
  --danger: #b42318;
  --c0: #7a3fd1;
  --c1: #0969da;
  --c2: #1a7f37;
  --c3: #6e7781;
  --c4: #bc4c00;
  --c5: #a40e6c;
  --font: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117;
    --card: #161b22;
    --text: #e6edf3;
    --muted: #9da7b3;
    --border: #30363d;
    --danger: #ff8b7e;
    --c0: #b392f0;
    --c1: #58a6ff;
    --c2: #56d364;
    --c3: #8b949e;
    --c4: #f0883e;
    --c5: #f778ba;
  }
}
* { box-sizing: border-box; }
[hidden] { display: none !important; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font: 15px/1.5 var(--font);
}
header, main, footer { max-width: 1040px; margin: 0 auto; padding: 0 16px; }
header { padding-top: 24px; display: flex; flex-wrap: wrap; gap: 12px; align-items: flex-end; justify-content: space-between; }
h1 { margin: 0; font-size: 1.6rem; }
h2 { margin: 0 0 12px; font-size: 1.15rem; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
h3 { margin: 16px 0 6px; font-size: 0.95rem; color: var(--muted); }
.sub { margin: 4px 0 0; color: var(--muted); }
section {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 16px;
  margin: 16px 0;
}
.cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
.card { border: 1px solid var(--border); border-radius: 8px; padding: 12px; }
.card .k { color: var(--muted); font-size: 0.85rem; }
.card .v { font-size: 1.6rem; font-weight: 650; }
.card .n { color: var(--muted); font-size: 0.8rem; }
.est {
  display: inline-block;
  border: 1px dashed var(--muted);
  border-radius: 999px;
  padding: 0 8px;
  color: var(--muted);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.02em;
  text-transform: uppercase;
}
.empty {
  margin: 0;
  padding: 16px;
  border: 1px dashed var(--border);
  border-radius: 8px;
  color: var(--muted);
}
.note { color: var(--muted); font-size: 0.85rem; margin: 8px 0 0; }
.warn { color: var(--danger); }
.toolbar { display: flex; gap: 6px; align-items: center; color: var(--muted); font-size: 0.85rem; }
.toolbar button {
  font: inherit;
  color: var(--text);
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 4px 12px;
  cursor: pointer;
}
.toolbar button[aria-pressed="true"] { border-color: var(--c1); box-shadow: inset 0 -2px 0 var(--c1); font-weight: 600; }
button:focus-visible, .chart [tabindex]:focus-visible { outline: 2px solid var(--c1); outline-offset: 2px; }
.pane { display: none; }
body[data-period="7"] .pane[data-pane="7"],
body[data-period="30"] .pane[data-pane="30"],
body[data-period="all"] .pane[data-pane="all"] { display: block; }
.chart { display: block; width: 100%; height: auto; max-width: 720px; }
.chart.donut { max-width: 210px; margin: 0 auto; }
.donuts { display: flex; flex-wrap: wrap; gap: 24px; justify-content: center; }
.donuts figure { margin: 0; flex: 0 1 220px; text-align: center; }
.donuts figcaption { color: var(--muted); font-size: 0.85rem; }
.s0 { --c: var(--c0); }
.s1 { --c: var(--c1); }
.s2 { --c: var(--c2); }
.s3 { --c: var(--c3); }
.s4 { --c: var(--c4); }
.s5 { --c: var(--c5); }
.line { fill: none; stroke: var(--c); stroke-width: 2.5; }
.line.dash { stroke-dasharray: 7 4; }
.dot, .bar { fill: var(--c); }
.dot:hover, .bar:hover { opacity: 0.8; }
.slice { stroke: var(--c); }
.ring { stroke: var(--border); }
.grid { stroke: var(--border); stroke-width: 1; }
.ref { stroke: var(--danger); stroke-width: 1.5; stroke-dasharray: 4 3; }
.tick, .nodata { fill: var(--muted); font-size: 11px; font-family: var(--font); }
.label, .val { fill: var(--text); font-size: 11px; font-family: var(--font); }
.center { fill: var(--text); font-size: 17px; font-weight: 600; font-family: var(--font); }
.legend { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; padding: 0; margin: 8px 0 0; font-size: 0.85rem; }
.sw { display: inline-block; width: 22px; height: 4px; margin-right: 6px; vertical-align: middle; background: var(--c); }
td .sw { width: 10px; height: 10px; border-radius: 2px; }
.sw.dash { background: repeating-linear-gradient(90deg, var(--c) 0 6px, transparent 6px 10px); }
.table-wrap { overflow-x: auto; margin-top: 12px; }
table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); }
th { color: var(--muted); font-weight: 600; }
.num { text-align: right; font-variant-numeric: tabular-nums; }
code { font-family: var(--mono); font-size: 0.9em; }
#tip {
  position: fixed;
  z-index: 10;
  max-width: 280px;
  padding: 6px 10px;
  border-radius: 6px;
  background: var(--text);
  color: var(--bg);
  font-size: 0.8rem;
  pointer-events: none;
}
footer { color: var(--muted); font-size: 0.8rem; padding-bottom: 32px; }
footer p { margin: 4px 0; }
@media (max-width: 560px) {
  body { font-size: 14px; }
  section { padding: 12px; }
  .card .v { font-size: 1.35rem; }
}
</style>
</head>
<body data-period="all">
<header><div><h1>tokred metrics</h1><p class="sub">Period: not recorded</p></div></header><main><section id="summary" aria-labelledby="summary-heading"><h2 id="summary-heading">Summary</h2><p class="empty">No data yet. The cards fill in once tokred has read your first transcripts.</p></section><section id="cost" aria-labelledby="cost-heading"><h2 id="cost-heading">Cost per day</h2><p class="empty">No data yet. The daily cost chart fills in once there are priced sessions.</p></section><section id="models" aria-labelledby="models-heading"><h2 id="models-heading">Distribution by model</h2><p class="empty">No data yet. The distribution fills in once tokred has priced some usage.</p></section><section id="routing" aria-labelledby="routing-heading"><h2 id="routing-heading">Routing</h2><p class="empty">No data yet. Routing statistics appear once the route and enforce hooks have run.</p></section><section id="guards" aria-labelledby="guards-heading"><h2 id="guards-heading">Guards <span class="est" title="Estimate: derived from sizes or projections, not measured">estimate</span></h2><p class="empty">No data yet. Guard statistics appear once the guard hooks have blocked a call.</p></section><section id="cache" aria-labelledby="cache-heading"><h2 id="cache-heading">Prompt cache</h2><p class="empty">No data yet. The cache hit rate fills in once there are priced sessions.</p></section><section id="latency" aria-labelledby="latency-heading"><h2 id="latency-heading">Latency</h2><p class="empty">No data yet. Latency appears once hooks have run and recorded their duration.</p></section><section id="audit" aria-labelledby="audit-heading"><h2 id="audit-heading">Audit <span class="est" title="Estimate: derived from sizes or projections, not measured">estimate</span></h2><p class="empty">No data yet. Run tokred audit to see the heaviest fixed-context items and unused MCP servers.</p></section></main><footer><p>Generated unknown &middot; tokred vunknown &middot; Period: not recorded &middot; Last price sync: never</p><p>Figures marked <span class="est">estimate</span> are derived (sizes / 4, projections), not measured. This file is self-contained and makes no network requests.</p></footer>
<div id="tip" role="tooltip" hidden></div>
<script type="application/json" id="data">{"meta":{"generated_at":"","tokred_version":"","period_start":null,"period_end":null,"last_price_sync":null},"summary":null,"cost_per_day":[],"models":[],"routing":null,"guards":[],"cache_per_day":[],"latency":null,"audit":null}</script>
<script>(function () {
  "use strict";
  var body = document.body;

  // Period toggle: switches between the precomputed 7 / 30 / all-days panes.
  var toolbar = document.getElementById("period-toolbar");
  if (toolbar) {
    toolbar.hidden = false;
    toolbar.addEventListener("click", function (event) {
      var button = event.target.closest("button[data-period]");
      if (!button) { return; }
      body.setAttribute("data-period", button.getAttribute("data-period"));
      toolbar.querySelectorAll("button").forEach(function (other) {
        other.setAttribute("aria-pressed", String(other === button));
      });
    });
  }

  // Tooltips: any element with a data-tip attribute (hover or keyboard focus).
  var tip = document.getElementById("tip");
  function place(x, y) {
    tip.style.left = Math.min(x + 12, window.innerWidth - tip.offsetWidth - 8) + "px";
    tip.style.top = Math.max(y - tip.offsetHeight - 12, 4) + "px";
  }
  function show(target, x, y) {
    tip.textContent = target.getAttribute("data-tip");
    tip.hidden = false;
    place(x, y);
  }
  document.addEventListener("mousemove", function (event) {
    var target = event.target.closest ? event.target.closest("[data-tip]") : null;
    if (target) { show(target, event.clientX, event.clientY); } else { tip.hidden = true; }
  });
  document.addEventListener("focusin", function (event) {
    var target = event.target.closest("[data-tip]");
    if (target) {
      var box = target.getBoundingClientRect();
      show(target, box.left + box.width / 2, box.top);
    }
  });
  document.addEventListener("focusout", function () { tip.hidden = true; });
  document.addEventListener("keydown", function (event) {
    if (event.key === "Escape") { tip.hidden = true; }
  });

  // The report data is embedded as JSON; expose it for ad-hoc inspection in the console.
  try {
    window.tokredReport = JSON.parse(document.getElementById("data").textContent);
  } catch (error) {
    window.tokredReport = null;
  }
})();
</script>
</body>
</html>
